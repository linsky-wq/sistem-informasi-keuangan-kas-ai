# Application Configuration
APP_NAME="Sistem Keuangan Kas AI"
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost/Project%20RPL/Project%20Kas

# Database Configuration (XAMPP MySQL / MariaDB)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=db_kas_ai
DB_USER=root
DB_PASS=

# Session & Security
SESSION_LIFETIME=7200
CSRF_SECRET=kas_ai_secure_token_key_change_me_in_prod

# AI Provider Selection: auto | gemini | groq | nvidia | mock
AI_PROVIDER=auto

# Google Gemini API (optional)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Groq Cloud API (optional)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions

# NVIDIA NIM integration (optional)
NVIDIA_ENABLED=false          # set to true to enable
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_API_URL=https://integrate.api.nvidia.com/v1/chat/completions
NVIDIA_MODEL=meta/llama-3.1-70b-instruct
# WhatsApp Integration Configuration (External Supporting Service)
WA_ENABLED=true
WA_PROVIDER=mock
WA_API_URL=https://api.fonnte.com/send
WA_API_TOKEN=
WA_SENDER_NUMBER=081234567890
WA_AUTO_NOTIFY_PAYMENT=true
WA_AUTO_NOTIFY_VERIFICATION=true
